-- index api_tokens_by_identity
CREATE INDEX api_tokens_by_identity ON api_tokens (identity_id);

-- index events_by_correlation
CREATE INDEX events_by_correlation ON events (correlation_id) WHERE correlation_id <> '';

-- index events_by_resource
CREATE INDEX events_by_resource ON events (resource_type, resource_id, seq);

-- index events_by_timestamp
CREATE INDEX events_by_timestamp ON events (timestamp);

-- index idempotency_records_by_expiry
CREATE INDEX idempotency_records_by_expiry ON idempotency_records (expires_at);

-- index jobs_by_resource
CREATE INDEX jobs_by_resource ON jobs (resource_type, resource_id);

-- index jobs_by_state_finished
CREATE INDEX jobs_by_state_finished ON jobs (state, finished_at);

-- index jobs_queue
CREATE INDEX jobs_queue ON jobs (state, scheduled_at);

-- index join_tokens_by_expiry
CREATE INDEX join_tokens_by_expiry ON join_tokens (expires_at);

-- index mcp_clients_by_requester
CREATE INDEX mcp_clients_by_requester ON mcp_clients (requested_by);

-- index mcp_clients_live_identity
CREATE UNIQUE INDEX mcp_clients_live_identity ON mcp_clients (identity_id) WHERE state <> 'deleted';

-- index mcp_clients_live_name
CREATE UNIQUE INDEX mcp_clients_live_name ON mcp_clients (name) WHERE state <> 'deleted';

-- index node_addresses_by_node
CREATE INDEX node_addresses_by_node ON node_addresses (node_id);

-- index node_routes_node
CREATE INDEX node_routes_node ON node_routes (node_id) WHERE phase <> 'removed';

-- index node_routes_one_live_hostname
CREATE UNIQUE INDEX node_routes_one_live_hostname ON node_routes (hostname) WHERE phase <> 'removed';

-- index node_routes_one_live_port
CREATE UNIQUE INDEX node_routes_one_live_port ON node_routes (node_id, port) WHERE phase <> 'removed';

-- index node_routes_one_per_plan
CREATE UNIQUE INDEX node_routes_one_per_plan ON node_routes (plan_id) WHERE plan_id IS NOT NULL;

-- index node_tags_by_tag
CREATE INDEX node_tags_by_tag ON node_tags (tag);

-- index nodes_by_environment
CREATE INDEX nodes_by_environment ON nodes (environment_id);

-- index nodes_by_name
CREATE INDEX nodes_by_name ON nodes (name);

-- index oauth_access_tokens_by_client
CREATE INDEX oauth_access_tokens_by_client ON oauth_access_tokens (mcp_client_id);

-- index oauth_access_tokens_by_expiry
CREATE INDEX oauth_access_tokens_by_expiry ON oauth_access_tokens (expires_at);

-- index observations_by_resource
CREATE INDEX observations_by_resource
    ON observations (resource_type, resource_id, kind, observed_at DESC);

-- index oidc_replay_by_expiry
CREATE INDEX oidc_replay_by_expiry ON oidc_replay (expires_at);

-- index operation_intents_by_job
CREATE INDEX operation_intents_by_job ON operation_intents (job_id, state);

-- index plans_by_hash
CREATE INDEX plans_by_hash ON plans (plan_hash);

-- index resource_locks_by_job
CREATE INDEX resource_locks_by_job ON resource_locks (job_id);

-- index services_by_node_name
CREATE INDEX services_by_node_name ON services (node_id, name);

-- index sessions_by_expiry
CREATE INDEX sessions_by_expiry ON sessions (expires_at);

-- index sessions_by_identity
CREATE INDEX sessions_by_identity ON sessions (identity_id);

-- index tunnel_enrollments_one_open
CREATE UNIQUE INDEX tunnel_enrollments_one_open ON tunnel_enrollments (name)
    WHERE phase NOT IN ('committed', 'expired', 'cancelled');

-- index tunnel_operations_one_active
CREATE UNIQUE INDEX tunnel_operations_one_active ON tunnel_operations (node_id)
    WHERE phase NOT IN ('committed', 'done');

-- table api_tokens
CREATE TABLE api_tokens (
    id           TEXT PRIMARY KEY,
    identity_id  TEXT NOT NULL REFERENCES identities (id),
    name         TEXT NOT NULL,
    token_hash   TEXT NOT NULL UNIQUE,
    scopes_json  TEXT NOT NULL DEFAULT '[]',
    created_at   INTEGER NOT NULL,
    expires_at   INTEGER NOT NULL CHECK (expires_at <= created_at + 31536000000),
    revoked_at   INTEGER,
    last_used_at INTEGER,
    UNIQUE (identity_id, name)
) STRICT;

-- table bootstrap_codes
CREATE TABLE bootstrap_codes (
    id             TEXT PRIMARY KEY,
    code_hash      TEXT NOT NULL UNIQUE,
    created_at     INTEGER NOT NULL,
    expires_at     INTEGER NOT NULL,
    consumed_at    INTEGER,
    consumed_by    TEXT REFERENCES identities (id),
    invalidated_at INTEGER
) STRICT;

-- table cloudflare_state
CREATE TABLE cloudflare_state (
    id                       INTEGER PRIMARY KEY CHECK (id = 1),
    revision                 INTEGER NOT NULL CHECK (revision >= 1),  -- bumped by every write; conditional updates compare it
    account_id               TEXT NOT NULL,
    service_token_id         TEXT NOT NULL,                           -- Cloudflare ID of the active Access service token
    service_token_name       TEXT NOT NULL,                           -- supermgmt-<instance-id>
    service_token_created_at INTEGER NOT NULL,
    service_token_expires_at INTEGER NOT NULL,
    rotation_phase           TEXT NOT NULL DEFAULT 'idle'
                             CHECK (rotation_phase IN ('idle', 'created', 'policy_updated', 'retiring')),
                                                                      -- created: new token exists; policy_updated: both admitted;
                                                                      -- retiring: old removed from policy, awaiting deletion
    pending_token_id         TEXT NOT NULL DEFAULT '',                -- the new token while a rotation runs
    pending_token_name       TEXT NOT NULL DEFAULT '',
    pending_token_created_at INTEGER,
    pending_token_expires_at INTEGER,
    service_policy_id        TEXT NOT NULL DEFAULT '',                -- owned policy "supermgmt service <instance-id>"
    owners_policy_id         TEXT NOT NULL DEFAULT '',                -- owned policy "supermgmt owners <instance-id>"
    last_error               TEXT NOT NULL DEFAULT '',                -- sanitized
    created_at               INTEGER NOT NULL,
    updated_at               INTEGER NOT NULL,
    CHECK ((rotation_phase = 'idle') = (pending_token_id = '')),
    CHECK ((pending_token_id = '') = (pending_token_created_at IS NULL) AND (pending_token_id = '') = (pending_token_expires_at IS NULL))
) STRICT;

-- table environments
CREATE TABLE environments (
    id            TEXT PRIMARY KEY,
    name          TEXT NOT NULL UNIQUE,
    risk_level    TEXT NOT NULL CHECK (risk_level IN ('development', 'staging', 'production')),
    config_json   TEXT NOT NULL DEFAULT '{}',
    spec_revision INTEGER NOT NULL DEFAULT 1
) STRICT;

-- table events
CREATE TABLE events (
    seq            INTEGER PRIMARY KEY AUTOINCREMENT,
    event_id       TEXT NOT NULL UNIQUE,
    timestamp      INTEGER NOT NULL,
    actor_type     TEXT NOT NULL CHECK (actor_type IN ('human', 'automation', 'mcp', 'system')),
    actor_id       TEXT NOT NULL,
    source         TEXT NOT NULL,
    action         TEXT NOT NULL,
    resource_type  TEXT NOT NULL DEFAULT '' CHECK (resource_type IN (
        '', 'node', 'service', 'app', 'app_target', 'deployment', 'environment', 'provider',
        'job', 'plan', 'event', 'instance', 'identity', 'secret')),
    resource_id    TEXT NOT NULL DEFAULT '',
    correlation_id TEXT NOT NULL DEFAULT '',
    severity       TEXT NOT NULL CHECK (severity IN ('info', 'warning', 'error')),
    result         TEXT NOT NULL CHECK (result IN ('succeeded', 'failed', 'denied', 'pending')),
    data_json      TEXT NOT NULL DEFAULT '{}'
) STRICT;

-- table idempotency_records
CREATE TABLE idempotency_records (
    identity_id   TEXT NOT NULL REFERENCES identities (id),
    key           TEXT NOT NULL,
    method        TEXT NOT NULL,
    path          TEXT NOT NULL,
    request_hash  TEXT NOT NULL,
    status_code   INTEGER NOT NULL,
    response_json TEXT NOT NULL,
    job_id        TEXT REFERENCES jobs (id),
    created_at    INTEGER NOT NULL,
    expires_at    INTEGER NOT NULL,
    PRIMARY KEY (identity_id, key)
) STRICT;

-- table identities
CREATE TABLE identities (
    id           TEXT PRIMARY KEY,
    actor_type   TEXT NOT NULL CHECK (actor_type IN ('human', 'automation', 'mcp', 'system')),
    issuer       TEXT NOT NULL DEFAULT '',
    subject      TEXT NOT NULL DEFAULT '',
    client_id    TEXT NOT NULL DEFAULT '',
    display_name TEXT NOT NULL DEFAULT '',
    email        TEXT NOT NULL DEFAULT '',
    created_at   INTEGER NOT NULL,
    last_seen_at INTEGER,
    disabled_at  INTEGER,
    UNIQUE (actor_type, issuer, subject, client_id)
) STRICT;

-- table instances
CREATE TABLE instances (
    id         TEXT PRIMARY KEY,
    name       TEXT NOT NULL,
    created_at INTEGER NOT NULL
) STRICT;

-- table interactive_sessions
CREATE TABLE interactive_sessions (
    id          TEXT PRIMARY KEY,
    identity_id TEXT NOT NULL REFERENCES identities (id),
    node_id     TEXT NOT NULL REFERENCES nodes (id),
    tool        TEXT NOT NULL CHECK (tool IN ('shell', 'lazydocker', 'btop', 'tmux')),
    state       TEXT NOT NULL CHECK (state IN ('issued', 'ended', 'abandoned')),
    exit_code   INTEGER,
    end_reason  TEXT CHECK (end_reason IN ('exited', 'launch_failed', 'abandoned')),
    created_at  INTEGER NOT NULL,
    ended_at    INTEGER
) STRICT;

-- table job_approvals
CREATE TABLE job_approvals (
    id          TEXT PRIMARY KEY,
    job_id      TEXT NOT NULL REFERENCES jobs (id),
    plan_hash   TEXT NOT NULL,
    approver_id TEXT NOT NULL REFERENCES identities (id),
    decision    TEXT NOT NULL CHECK (decision IN ('approve', 'reject')),
    reason      TEXT NOT NULL DEFAULT '',
    expires_at  INTEGER NOT NULL,
    renewed_at  INTEGER,
    created_at  INTEGER NOT NULL,
    UNIQUE (job_id, plan_hash, approver_id)
) STRICT;

-- table jobs
CREATE TABLE jobs (
    id               TEXT PRIMARY KEY,
    type             TEXT NOT NULL,
    resource_type    TEXT NOT NULL CHECK (resource_type IN (
        'node', 'service', 'app', 'app_target', 'deployment', 'environment', 'provider',
        'job', 'plan', 'event', 'instance', 'identity', 'secret')),
    resource_id      TEXT NOT NULL,
    actor_id         TEXT NOT NULL REFERENCES identities (id),
    credential_kind  TEXT NOT NULL CHECK (credential_kind IN (
        'local_socket', 'session', 'api_token', 'mcp_token', 'oauth_access_token', 'github_oidc')),
    credential_id    TEXT NOT NULL DEFAULT '',
    scopes_json      TEXT NOT NULL DEFAULT '[]',
    state            TEXT NOT NULL CHECK (state IN (
        'awaiting_approval', 'queued', 'running', 'interrupted',
        'succeeded', 'failed', 'cancelled')),
    risk             TEXT NOT NULL CHECK (risk IN (
        'read', 'operational', 'high', 'destructive', 'governance')),
    retry_class      TEXT NOT NULL CHECK (retry_class IN (
        'idempotent', 'resumable', 'non_retryable')),
    idempotency_key  TEXT,
    payload_json     TEXT NOT NULL DEFAULT '{}',
    plan_id          TEXT REFERENCES plans (id) DEFERRABLE INITIALLY DEFERRED,
    plan_hash        TEXT,
    lease_owner      TEXT,
    lease_generation INTEGER NOT NULL DEFAULT 0,
    lease_until      INTEGER,
    heartbeat_at     INTEGER,
    attempts         INTEGER NOT NULL DEFAULT 0,
    max_attempts     INTEGER NOT NULL DEFAULT 1,
    scheduled_at     INTEGER NOT NULL,
    created_at       INTEGER NOT NULL,
    started_at       INTEGER,
    finished_at      INTEGER,
    error_json       TEXT
) STRICT;

-- table join_tokens
CREATE TABLE join_tokens (
    id               TEXT PRIMARY KEY,
    token_hash       TEXT NOT NULL UNIQUE,
    created_by       TEXT NOT NULL REFERENCES identities (id),
    constraints_json TEXT NOT NULL DEFAULT '{}',
    uses             INTEGER NOT NULL DEFAULT 0,
    created_at       INTEGER NOT NULL,
    expires_at       INTEGER NOT NULL,
    consumed_at      INTEGER,
    invalidated_at   INTEGER
) STRICT;

-- table mcp_clients
CREATE TABLE mcp_clients (
    id                  TEXT PRIMARY KEY,                         -- credential_id of its mcp_token
    identity_id         TEXT NOT NULL REFERENCES identities (id), -- not UNIQUE: history survives re-registration
    name                TEXT NOT NULL,
    origin              TEXT NOT NULL CHECK (origin IN ('local', 'remote')),
    state               TEXT NOT NULL CHECK (state IN ('pending_token', 'active', 'deleted')),
    requested_by        TEXT NOT NULL REFERENCES identities (id),
    registration_job_id TEXT REFERENCES jobs (id),                -- NULL when policy needed no approval
    approved_at         INTEGER NOT NULL,                         -- start of the 24h issuance window
    token_hash          TEXT UNIQUE,                              -- local only; NULL until issued
    token_issued_at     INTEGER,
    token_expires_at    INTEGER,
    revoked_at          INTEGER,
    last_used_at        INTEGER,
    created_at          INTEGER NOT NULL,                         -- lower bound for accepted OAuth iat
    updated_at          INTEGER NOT NULL,
    deleted_at          INTEGER, over_https INTEGER NOT NULL DEFAULT 0
    CHECK (over_https IN (0, 1) AND (over_https = 0 OR origin = 'local')),
    CHECK (origin = 'local' OR token_hash IS NULL),
    CHECK ((token_hash IS NULL) = (token_issued_at IS NULL) AND (token_hash IS NULL) = (token_expires_at IS NULL)),
    CHECK (token_expires_at IS NULL OR token_expires_at <= token_issued_at + 31536000000),
    CHECK (state <> 'active' OR origin = 'remote' OR token_hash IS NOT NULL),
    CHECK ((state = 'deleted') = (deleted_at IS NOT NULL))
) STRICT;

-- table node_addresses
CREATE TABLE node_addresses (
    id           TEXT PRIMARY KEY,
    node_id      TEXT NOT NULL REFERENCES nodes (id),
    address      TEXT NOT NULL,
    family       TEXT NOT NULL CHECK (family IN ('ipv4', 'ipv6')),
    scope        TEXT NOT NULL CHECK (scope IN ('global', 'private', 'link', 'loopback')),
    source       TEXT NOT NULL CHECK (source IN ('probe', 'provider')),
    preferred    INTEGER NOT NULL DEFAULT 0 CHECK (preferred IN (0, 1)),
    last_seen_at INTEGER NOT NULL,
    UNIQUE (node_id, address)
) STRICT;

-- table node_capabilities
CREATE TABLE node_capabilities (
    node_id       TEXT NOT NULL REFERENCES nodes (id) ON DELETE CASCADE,
    capability    TEXT NOT NULL,
    available     INTEGER NOT NULL CHECK (available IN (0, 1)),
    metadata_json TEXT NOT NULL DEFAULT '{}',
    checked_at    INTEGER NOT NULL,
    PRIMARY KEY (node_id, capability)
) STRICT;

-- table node_routes
CREATE TABLE node_routes (
    id                TEXT PRIMARY KEY,
    node_id           TEXT NOT NULL REFERENCES nodes (id),       -- its tunnel carries the route
    hostname          TEXT NOT NULL CHECK (hostname <> '' AND hostname = lower(hostname)),
    port              INTEGER NOT NULL CHECK (port BETWEEN 1 AND 65535),
    access            TEXT NOT NULL CHECK (access IN ('public', 'owners')),
    phase             TEXT NOT NULL CHECK (phase IN (
                          'admitted', 'provisioning', 'ingress_ready', 'access_ready', 'active',  -- expose, in order; admitted serves no rule
                          'removing', 'dns_removed', 'ingress_removed', 'removed',     -- unexpose, in order
                          'failed', 'conflict')),                 -- halted: see halted_phase
    halted_phase      TEXT CHECK (halted_phase IS NULL OR halted_phase IN (
                          'admitted', 'provisioning', 'ingress_ready', 'access_ready', 'active',
                          'removing', 'dns_removed', 'ingress_removed', 'removed')), -- phase held when the route halted; NULL otherwise
    phase_started_at  INTEGER NOT NULL,                          -- adoption of an object requires created_at >= this
    account_id        TEXT NOT NULL,                             -- Cloudflare account the objects live in
    zone              TEXT NOT NULL,                             -- DNS zone name
    instance_id       TEXT NOT NULL,                             -- SuperMgmt instance ID baked into object names
    tunnel_id         TEXT NOT NULL CHECK (tunnel_id <> ''),     -- the node's tunnel when the route was accepted
    tunnel_generation INTEGER NOT NULL CHECK (tunnel_generation >= 1), -- the node's committed enable generation then
    dns_record_id     TEXT NOT NULL DEFAULT '',                  -- '' until created; set once
    access_app_id     TEXT NOT NULL DEFAULT '',                  -- '' until created; set once
    last_error        TEXT NOT NULL DEFAULT '',                  -- sanitized; never a token, header or response body
    plan_id           TEXT REFERENCES plans (id),                -- the plan whose admission wrote the row; NULL only for rows inserted outside a plan
    created_by        TEXT NOT NULL REFERENCES identities (id),
    created_at        INTEGER NOT NULL,
    updated_at        INTEGER NOT NULL,
    CHECK ((phase IN ('failed', 'conflict')) = (halted_phase IS NOT NULL)),
    CHECK (phase_started_at <= updated_at)
) STRICT;

-- table node_tags
CREATE TABLE node_tags (
    node_id TEXT NOT NULL REFERENCES nodes (id) ON DELETE CASCADE,
    tag     TEXT NOT NULL,
    PRIMARY KEY (node_id, tag)
) STRICT;

-- table nodes
CREATE TABLE nodes (
    id               TEXT PRIMARY KEY,
    provider_id      TEXT NOT NULL REFERENCES providers (id),
    native_id        TEXT NOT NULL,
    name             TEXT NOT NULL,
    kind             TEXT NOT NULL,
    environment_id   TEXT REFERENCES environments (id),
    management_state TEXT NOT NULL CHECK (management_state IN ('discovered', 'managed', 'retired')),
    reachability     TEXT NOT NULL DEFAULT 'unknown'
                     CHECK (reachability IN ('reachable', 'unreachable', 'unknown')),
    endpoint_json    TEXT NOT NULL DEFAULT '{}',
    credential_ref   TEXT NOT NULL DEFAULT '',
    os               TEXT NOT NULL DEFAULT '',
    arch             TEXT NOT NULL DEFAULT '',
    metadata_json    TEXT NOT NULL DEFAULT '{}',
    spec_revision    INTEGER NOT NULL DEFAULT 1,
    created_at       INTEGER NOT NULL,
    updated_at       INTEGER NOT NULL,
    last_seen_at     INTEGER,
    UNIQUE (provider_id, native_id)
) STRICT;

-- table oauth_access_tokens
CREATE TABLE oauth_access_tokens (
    id            TEXT PRIMARY KEY,                               -- credential_id
    mcp_client_id TEXT NOT NULL REFERENCES mcp_clients (id),
    token_hash    TEXT NOT NULL UNIQUE,                           -- SHA-256 of the presented token
    issuer        TEXT NOT NULL,
    jti           TEXT NOT NULL DEFAULT '',
    issued_at     INTEGER NOT NULL,
    expires_at    INTEGER NOT NULL,
    revoked_at    INTEGER,
    first_seen_at INTEGER NOT NULL,
    last_used_at  INTEGER
) STRICT;

-- table observations
CREATE TABLE observations (
    id            TEXT PRIMARY KEY,
    resource_type TEXT NOT NULL CHECK (resource_type IN (
        'node', 'service', 'app', 'app_target', 'deployment', 'environment', 'provider',
        'job', 'plan', 'event', 'instance', 'identity', 'secret')),
    resource_id   TEXT NOT NULL,
    kind          TEXT NOT NULL,
    value_json    TEXT NOT NULL,
    observed_at   INTEGER NOT NULL,
    expires_at    INTEGER
) STRICT;

-- table oidc_replay
CREATE TABLE oidc_replay (
    issuer     TEXT NOT NULL,
    jti        TEXT NOT NULL,
    expires_at INTEGER NOT NULL,
    PRIMARY KEY (issuer, jti)
) STRICT;

-- table operation_intents
CREATE TABLE operation_intents (
    id               TEXT PRIMARY KEY,
    job_id           TEXT NOT NULL REFERENCES jobs (id),
    step             TEXT NOT NULL,
    lease_generation INTEGER NOT NULL,
    state            TEXT NOT NULL CHECK (state IN ('recorded', 'completed')),
    operation        TEXT NOT NULL,
    target_type      TEXT NOT NULL,
    target_id        TEXT NOT NULL,
    marker           TEXT NOT NULL,
    pre_state_json   TEXT,
    deadline_at      INTEGER NOT NULL,
    dispatched_at    INTEGER,
    completed_at     INTEGER,
    outcome          TEXT,
    evidence_json    TEXT, external_ref TEXT,
    UNIQUE (marker)
) STRICT;

-- table plans
CREATE TABLE plans (
    id               TEXT PRIMARY KEY,
    action           TEXT NOT NULL,
    actor_id         TEXT NOT NULL REFERENCES identities (id),
    credential_kind  TEXT NOT NULL CHECK (credential_kind IN (
        'local_socket', 'session', 'api_token', 'mcp_token', 'oauth_access_token', 'github_oidc')),
    credential_id    TEXT NOT NULL DEFAULT '',
    scopes_json      TEXT NOT NULL DEFAULT '[]',
    plan_json        TEXT NOT NULL,
    plan_hash        TEXT NOT NULL,
    finalized_at     INTEGER NOT NULL,
    created_at       INTEGER NOT NULL,
    expires_at       INTEGER NOT NULL,
    submitted_job_id TEXT REFERENCES jobs (id) DEFERRABLE INITIALLY DEFERRED,
    UNIQUE (submitted_job_id)
) STRICT;

-- table providers
CREATE TABLE providers (
    id             TEXT PRIMARY KEY,
    type           TEXT NOT NULL,
    name           TEXT NOT NULL UNIQUE,
    origin         TEXT NOT NULL CHECK (origin IN ('static', 'api')),
    endpoint       TEXT NOT NULL DEFAULT '',
    credential_ref TEXT NOT NULL DEFAULT '',
    config_json    TEXT NOT NULL DEFAULT '{}',
    status         TEXT NOT NULL DEFAULT '',
    spec_revision  INTEGER NOT NULL DEFAULT 1,
    last_sync_at   INTEGER,
    created_at     INTEGER NOT NULL,
    updated_at     INTEGER NOT NULL
) STRICT;

-- table resource_locks
CREATE TABLE resource_locks (
    resource_type TEXT NOT NULL,
    resource_id   TEXT NOT NULL,
    job_id        TEXT NOT NULL REFERENCES jobs (id),
    mode          TEXT NOT NULL CHECK (mode IN ('exclusive', 'shared')),
    acquired_at   INTEGER NOT NULL,
    PRIMARY KEY (resource_type, resource_id, job_id)
) STRICT;

-- table role_bindings
CREATE TABLE role_bindings (
    id          TEXT PRIMARY KEY,
    identity_id TEXT NOT NULL REFERENCES identities (id),
    role_id     TEXT NOT NULL REFERENCES roles (id),
    created_at  INTEGER NOT NULL,
    UNIQUE (identity_id, role_id)
) STRICT;

-- table roles
CREATE TABLE roles (
    id          TEXT PRIMARY KEY,
    name        TEXT NOT NULL UNIQUE,
    description TEXT NOT NULL DEFAULT ''
) STRICT;

-- table runtimes
CREATE TABLE runtimes (
    id            TEXT PRIMARY KEY,
    node_id       TEXT NOT NULL REFERENCES nodes (id),
    type          TEXT NOT NULL,
    native_id     TEXT NOT NULL,
    version       TEXT NOT NULL DEFAULT '',
    status        TEXT NOT NULL DEFAULT '',
    metadata_json TEXT NOT NULL DEFAULT '{}',
    last_seen_at  INTEGER,
    UNIQUE (node_id, type, native_id)
) STRICT;

-- table schema_migrations
CREATE TABLE schema_migrations (
    version    INTEGER PRIMARY KEY,
    applied_at INTEGER NOT NULL
) STRICT;

-- table secrets
CREATE TABLE secrets (
    id               TEXT PRIMARY KEY,
    name             TEXT NOT NULL,
    version          INTEGER NOT NULL,
    envelope_version INTEGER NOT NULL CHECK (envelope_version = 1),
    kek_id           TEXT NOT NULL,
    wrapped_dek      BLOB NOT NULL,
    ciphertext       BLOB NOT NULL,
    metadata_json    TEXT NOT NULL DEFAULT '{}',
    created_at       INTEGER NOT NULL,
    rotated_at       INTEGER,
    UNIQUE (name, version)
) STRICT;

-- table services
CREATE TABLE services (
    id            TEXT PRIMARY KEY,
    runtime_id    TEXT NOT NULL REFERENCES runtimes (id),
    node_id       TEXT NOT NULL REFERENCES nodes (id),
    native_id     TEXT NOT NULL,
    name          TEXT NOT NULL,
    kind          TEXT NOT NULL,
    status        TEXT NOT NULL DEFAULT '',
    health        TEXT NOT NULL DEFAULT '',
    metadata_json TEXT NOT NULL DEFAULT '{}',
    spec_revision INTEGER NOT NULL DEFAULT 1,
    last_seen_at  INTEGER,
    UNIQUE (runtime_id, native_id)
) STRICT;

-- table sessions
CREATE TABLE sessions (
    id           TEXT PRIMARY KEY,
    identity_id  TEXT NOT NULL REFERENCES identities (id),
    token_hash   TEXT NOT NULL UNIQUE,
    client       TEXT NOT NULL DEFAULT '',
    origin       TEXT NOT NULL CHECK (origin IN ('oidc', 'bootstrap')),
    created_at   INTEGER NOT NULL,
    expires_at   INTEGER NOT NULL,
    revoked_at   INTEGER,
    last_used_at INTEGER
) STRICT;

-- table settings
CREATE TABLE settings (
    key        TEXT PRIMARY KEY,
    value_json TEXT NOT NULL,
    updated_at INTEGER NOT NULL
) STRICT;

-- table sqlite_sequence
CREATE TABLE sqlite_sequence(name,seq);

-- table tunnel_enrollments
CREATE TABLE tunnel_enrollments (
    id                      TEXT PRIMARY KEY,                    -- the node ID allocated for the enrollment
    name                    TEXT NOT NULL CHECK (name <> ''),
    environment_id          TEXT REFERENCES environments (id),
    tags_json               TEXT NOT NULL DEFAULT '[]',
    phase                   TEXT NOT NULL CHECK (phase IN (
                                'started', 'token_ready', 'tunnel_created', 'ingress_set', 'access_ready',
                                'dns_created',                    -- enable, in order; dns_created = waiting for the node
                                'scanned', 'confirmed', 'committed',  -- host key scanned over the tunnel, confirmed by the operator, node written
                                'removing', 'route_closed', 'access_removed', 'tunnel_deleted',  -- cleanup, in order
                                'expired', 'cancelled',           -- cleanup done: the terminal outcomes without a node
                                'mismatch',                       -- the host key was refused; goes on to removing
                                'failed', 'conflict')),           -- halted: see halted_phase
    halted_phase            TEXT CHECK (halted_phase IS NULL OR halted_phase IN (
                                'started', 'token_ready', 'tunnel_created', 'ingress_set', 'access_ready',
                                'dns_created', 'scanned', 'confirmed', 'committed',
                                'removing', 'route_closed', 'access_removed', 'tunnel_deleted',
                                'expired', 'cancelled', 'mismatch')),  -- phase held when the enrollment halted; NULL otherwise
    phase_started_at        INTEGER NOT NULL,                    -- adoption of an object requires created_at >= this
    account_id              TEXT NOT NULL,                       -- Cloudflare account the objects live in
    zone                    TEXT NOT NULL,                       -- DNS zone name
    instance_id             TEXT NOT NULL,                       -- SuperMgmt instance ID baked into object names
    hostname                TEXT NOT NULL,                       -- ssh-<name>.<zone>
    tunnel_id               TEXT NOT NULL DEFAULT '',            -- '' until created; set once
    dns_record_id           TEXT NOT NULL DEFAULT '',            -- '' until created; set once
    access_app_id           TEXT NOT NULL DEFAULT '',            -- '' until created; set once
    expires_at              INTEGER NOT NULL,
    started_by              TEXT NOT NULL,                       -- identity that started the enrollment; the only one that reads the token and confirms or refuses the key
    identity_public_key     TEXT NOT NULL,                       -- SSH identity snapshot taken at start; used by the line, the proof and the commit
    identity_fingerprint    TEXT NOT NULL,
    identity_credential_ref TEXT NOT NULL,                       -- versioned secret reference of the snapshot's private key
    scanned_host_key        TEXT NOT NULL DEFAULT '',            -- authorized_keys form, as scanned over the tunnel
    confirmed_host_key      TEXT NOT NULL DEFAULT '',            -- '' until confirmed; set once, and equal to the scanned key
    token_ref               TEXT NOT NULL DEFAULT '',            -- secret-store reference of the connector token; never the token
    terminal_reason         TEXT NOT NULL DEFAULT '',            -- why the enrollment is being removed or ended
    last_error              TEXT NOT NULL DEFAULT '',            -- sanitized; never a token, header or response body
    created_at              INTEGER NOT NULL,
    updated_at              INTEGER NOT NULL,
    CHECK ((phase IN ('failed', 'conflict')) = (halted_phase IS NOT NULL)),
    CHECK (phase_started_at <= updated_at),
    CHECK (expires_at > created_at),
    CHECK (confirmed_host_key = '' OR confirmed_host_key = scanned_host_key),
    CHECK (phase <> 'scanned' OR scanned_host_key <> ''),
    CHECK (phase <> 'confirmed' OR confirmed_host_key <> '')
) STRICT;

-- table tunnel_operations
CREATE TABLE tunnel_operations (
    id               TEXT PRIMARY KEY,
    node_id          TEXT NOT NULL REFERENCES nodes (id),
    generation       INTEGER NOT NULL CHECK (generation >= 1),   -- per node, 1, 2, 3...; stale writers carry an old one
    operation        TEXT NOT NULL CHECK (operation IN ('enable', 'disable')),
    phase            TEXT NOT NULL CHECK (phase IN (
                         'started',                                -- both: record written, nothing created yet
                         'token_ready', 'tunnel_created', 'ingress_set', 'access_ready',
                         'dns_created', 'installed', 'verified', 'committed',                      -- enable, in order
                         'direct_verified', 'switched', 'service_removed', 'route_closed',
                         'access_removed', 'tunnel_deleted', 'done',                               -- disable, in order
                         'failed', 'conflict')),                   -- halted: see halted_phase
    halted_phase     TEXT CHECK (halted_phase IS NULL OR halted_phase IN (
                         'started',
                         'token_ready', 'tunnel_created', 'ingress_set', 'access_ready',
                         'dns_created', 'installed', 'verified', 'committed',
                         'direct_verified', 'switched', 'service_removed', 'route_closed',
                         'access_removed', 'tunnel_deleted', 'done')), -- phase held when the operation halted; NULL otherwise
    phase_started_at INTEGER NOT NULL,                           -- adoption of an object requires created_at >= this
    account_id       TEXT NOT NULL,                              -- Cloudflare account the objects live in
    zone             TEXT NOT NULL,                              -- DNS zone name
    instance_id      TEXT NOT NULL,                              -- SuperMgmt instance ID baked into object names
    hostname         TEXT NOT NULL DEFAULT '',                   -- DNS name of the tunnelled node
    tunnel_id        TEXT NOT NULL DEFAULT '',                   -- '' until created; set once
    dns_record_id    TEXT NOT NULL DEFAULT '',                   -- '' until created; set once
    access_app_id    TEXT NOT NULL DEFAULT '',                   -- '' until created; set once
    last_error       TEXT NOT NULL DEFAULT '',                   -- sanitized; never a token, header or response body
    created_at       INTEGER NOT NULL,
    updated_at       INTEGER NOT NULL,
    UNIQUE (node_id, generation),
    CHECK ((phase IN ('failed', 'conflict')) = (halted_phase IS NOT NULL)),
    CHECK (operation = 'enable'  AND (phase NOT IN ('direct_verified', 'switched', 'service_removed', 'route_closed',
                                                   'access_removed', 'tunnel_deleted', 'done')
                                       AND COALESCE(halted_phase, 'started') NOT IN ('direct_verified', 'switched', 'service_removed',
                                                   'route_closed', 'access_removed', 'tunnel_deleted', 'done'))
        OR operation = 'disable' AND (phase NOT IN ('token_ready', 'tunnel_created', 'ingress_set', 'access_ready',
                                                   'dns_created', 'installed', 'verified', 'committed')
                                       AND COALESCE(halted_phase, 'started') NOT IN ('token_ready', 'tunnel_created', 'ingress_set',
                                                   'access_ready', 'dns_created', 'installed', 'verified', 'committed'))),
    CHECK (phase_started_at <= updated_at)
) STRICT;

-- trigger events_no_delete
CREATE TRIGGER events_no_delete BEFORE DELETE ON events
BEGIN
    SELECT RAISE(ABORT, 'events are append-only');
END;

-- trigger events_no_update
CREATE TRIGGER events_no_update BEFORE UPDATE ON events
BEGIN
    SELECT RAISE(ABORT, 'events are append-only');
END;

-- trigger mcp_clients_identity_is_mcp
CREATE TRIGGER mcp_clients_identity_is_mcp BEFORE INSERT ON mcp_clients
WHEN (SELECT actor_type FROM identities WHERE id = NEW.identity_id) IS NOT 'mcp'
BEGIN SELECT RAISE(ABORT, 'mcp_clients.identity_id must be an mcp identity'); END;

-- trigger mcp_clients_state_forward
CREATE TRIGGER mcp_clients_state_forward BEFORE UPDATE OF state ON mcp_clients
WHEN NOT ((OLD.state = 'pending_token' AND NEW.state IN ('active', 'deleted'))
       OR (OLD.state = 'active' AND NEW.state = 'deleted') OR OLD.state = NEW.state)
BEGIN SELECT RAISE(ABORT, 'invalid mcp client state transition'); END;

-- trigger mcp_clients_token_once
CREATE TRIGGER mcp_clients_token_once BEFORE UPDATE OF token_hash ON mcp_clients
WHEN OLD.token_hash IS NOT NULL
BEGIN SELECT RAISE(ABORT, 'an mcp client token is issued once'); END;

-- trigger node_routes_final
CREATE TRIGGER node_routes_final BEFORE UPDATE OF phase ON node_routes
WHEN OLD.phase = 'removed' AND NEW.phase <> OLD.phase
BEGIN SELECT RAISE(ABORT, 'a removed node route does not change phase'); END;

-- trigger node_routes_ids_once
CREATE TRIGGER node_routes_ids_once BEFORE UPDATE OF id, node_id, hostname, port, access, account_id, zone,
        instance_id, tunnel_id, tunnel_generation, dns_record_id, access_app_id, plan_id, created_by, created_at ON node_routes
WHEN (OLD.dns_record_id <> '' AND NEW.dns_record_id <> OLD.dns_record_id)
  OR (OLD.access_app_id <> '' AND NEW.access_app_id <> OLD.access_app_id)
  OR NEW.id <> OLD.id OR NEW.node_id <> OLD.node_id
  OR NEW.hostname <> OLD.hostname OR NEW.port <> OLD.port OR NEW.access <> OLD.access
  OR NEW.account_id <> OLD.account_id OR NEW.zone <> OLD.zone OR NEW.instance_id <> OLD.instance_id
  OR NEW.tunnel_id <> OLD.tunnel_id OR NEW.tunnel_generation <> OLD.tunnel_generation
  OR (OLD.plan_id IS NOT NULL AND NEW.plan_id IS NOT OLD.plan_id) OR NEW.created_by <> OLD.created_by OR NEW.created_at <> OLD.created_at
BEGIN SELECT RAISE(ABORT, 'a node route keeps its identity and recorded object IDs'); END;

-- trigger oauth_access_tokens_stay_revoked
CREATE TRIGGER oauth_access_tokens_stay_revoked BEFORE UPDATE OF revoked_at, mcp_client_id ON oauth_access_tokens
WHEN OLD.revoked_at IS NOT NULL OR NEW.mcp_client_id IS NOT OLD.mcp_client_id
BEGIN SELECT RAISE(ABORT, 'an oauth access token row never changes client or un-revokes'); END;

-- trigger secrets_discard_staged
CREATE TRIGGER secrets_discard_staged AFTER UPDATE OF state ON jobs
WHEN NEW.type = 'control_plane.apply' AND NEW.state IN ('failed', 'cancelled')
BEGIN
    DELETE FROM secrets WHERE version < 0 AND id = json_extract(NEW.payload_json, '$.staged_id');
END;

-- trigger tunnel_enrollments_final
CREATE TRIGGER tunnel_enrollments_final BEFORE UPDATE OF phase ON tunnel_enrollments
WHEN OLD.phase IN ('committed', 'expired', 'cancelled') AND NEW.phase <> OLD.phase
BEGIN SELECT RAISE(ABORT, 'a finished tunnel enrollment does not change phase'); END;

-- trigger tunnel_enrollments_ids_once
CREATE TRIGGER tunnel_enrollments_ids_once BEFORE UPDATE OF id, name, environment_id, tags_json, account_id, zone,
        instance_id, hostname, tunnel_id, dns_record_id, access_app_id, expires_at, started_by, identity_public_key,
        identity_fingerprint, identity_credential_ref, confirmed_host_key, token_ref, created_at ON tunnel_enrollments
WHEN (OLD.tunnel_id <> '' AND NEW.tunnel_id <> OLD.tunnel_id)
  OR (OLD.dns_record_id <> '' AND NEW.dns_record_id <> OLD.dns_record_id)
  OR (OLD.access_app_id <> '' AND NEW.access_app_id <> OLD.access_app_id)
  OR (OLD.confirmed_host_key <> '' AND NEW.confirmed_host_key <> OLD.confirmed_host_key)
  OR (OLD.token_ref <> '' AND NEW.token_ref <> OLD.token_ref)
  OR NEW.id <> OLD.id OR NEW.name <> OLD.name OR NEW.environment_id IS NOT OLD.environment_id
  OR NEW.tags_json <> OLD.tags_json OR NEW.account_id <> OLD.account_id OR NEW.zone <> OLD.zone
  OR NEW.instance_id <> OLD.instance_id OR NEW.hostname <> OLD.hostname OR NEW.expires_at <> OLD.expires_at
  OR NEW.started_by <> OLD.started_by
  OR NEW.identity_public_key <> OLD.identity_public_key OR NEW.identity_fingerprint <> OLD.identity_fingerprint
  OR NEW.identity_credential_ref <> OLD.identity_credential_ref OR NEW.created_at <> OLD.created_at
BEGIN SELECT RAISE(ABORT, 'a tunnel enrollment keeps its identity snapshot and recorded object IDs'); END;

-- trigger tunnel_operations_ids_once
CREATE TRIGGER tunnel_operations_ids_once BEFORE UPDATE OF tunnel_id, dns_record_id, access_app_id, node_id, generation, operation ON tunnel_operations
WHEN (OLD.tunnel_id <> '' AND NEW.tunnel_id <> OLD.tunnel_id)
  OR (OLD.dns_record_id <> '' AND NEW.dns_record_id <> OLD.dns_record_id)
  OR (OLD.access_app_id <> '' AND NEW.access_app_id <> OLD.access_app_id)
  OR NEW.node_id <> OLD.node_id OR NEW.generation <> OLD.generation OR NEW.operation <> OLD.operation
BEGIN SELECT RAISE(ABORT, 'a tunnel operation keeps its identity and recorded object IDs'); END;

