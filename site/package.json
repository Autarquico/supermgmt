{
  "name": "supermgmt-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.23.3",
    "npm": "11.21.0"
  },
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "npm run sync && astro dev",
    "build": "npm run sync && astro build && node scripts/font-licenses.mjs",
