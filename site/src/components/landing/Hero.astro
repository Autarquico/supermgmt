---
import { routeFor } from '../../../scripts/sync-docs.mjs';

const repoUrl = 'https://github.com/autarquico/supermgmt';
---

<section class="hero" aria-labelledby="hero-title">
	<p class="badge">pre-alpha · build from source</p>
	<h1 id="hero-title">Every change is a plan. Every plan has a hash. Production <em>waits</em> for you.</h1>
	<p class="lead">A local-first control plane for your own infrastructure, safe for humans and AI agents.</p>
	<p class="actions">
		<a class="button primary" href={routeFor('overview')}>Read the docs</a>
		<a class="button secondary" href={repoUrl}>View on GitHub</a>
	</p>
</section>

<style>
	.hero {
		padding-block: var(--sm-space-9) var(--sm-space-8);
	}
	.badge {
		display: inline-block;
		margin: 0 0 var(--sm-space-6);
		padding: var(--sm-space-1) var(--sm-space-3);
		border: 1px solid var(--sm-border);
		border-radius: var(--sm-radius-pill);
		font-family: var(--sm-font-mono);
		font-size: var(--sl-text-sm);
		color: var(--sm-text-muted);
	}
	h1 {
		max-width: 16ch;
		margin: 0;
		font-size: clamp(2.375rem, 7vw, 3.75rem);
		line-height: var(--sl-line-height-headings);
		color: var(--sm-text-strong);
	}
	h1 em {
		font-style: italic;
		color: var(--sm-accent);
	}
	.lead {
		max-width: 40rem;
		margin: var(--sm-space-6) 0 0;
		font-size: var(--sl-text-xl);
		line-height: 1.5;
		color: var(--sm-text);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: var(--sm-space-4);
		margin: var(--sm-space-7) 0 0;
	}
	.button {
		display: inline-flex;
		align-items: center;
		min-height: var(--sm-tap-target);
		padding-inline: var(--sm-space-5);
		border: 1px solid var(--sm-border);
		border-radius: var(--sm-radius-control);
		font-weight: 500;
		text-decoration: none;
	}
	.primary {
		background: var(--sm-accent);
		border-color: var(--sm-accent);
		color: var(--sm-on-accent);
	}
	.primary:hover {
		background: var(--sm-accent-hover);
		border-color: var(--sm-accent-hover);
	}
	.primary:active {
		background: var(--sm-accent-active);
		border-color: var(--sm-accent-active);
	}
	.secondary {
		color: var(--sm-text-strong);
	}
	.secondary:hover {
		border-color: var(--sm-accent);
	}
</style>
